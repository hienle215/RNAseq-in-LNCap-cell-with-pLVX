###############################################################
## Build tx2gene
###############################################################

example <- read_tsv(
    files[1],
    show_col_types = FALSE
)

split.ids <- str_split_fixed(
    example$target_id,
    "\\|",
    9
)

tx2gene <- tibble(
    TXNAME = example$target_id,
    GENEID = split.ids[,2],
    SYMBOL = split.ids[,6]
)

tx2gene <- distinct(tx2gene)

head(tx2gene)
###############################################################
## Import all 24 samples
###############################################################

txi <- tximport(
    files,
    type = "kallisto",
    tx2gene = tx2gene
)
library(DESeq2)

run_dox_comparison <- function(group_name) {
    
    keep <- sample.info$group == group_name
    
    count_sub <- txi$counts[, keep]
    
    coldata_sub <- sample.info[keep, ]
    
    dds <- DESeqDataSetFromMatrix(
        countData = round(count_sub),
        colData = coldata_sub,
        design = ~ dox
    )
    
    dds <- dds[rowSums(counts(dds) >= 10) >= 3, ]
    
    dds <- DESeq(dds)
    
    res <- results(
        dds,
        contrast = c("dox", "dox", "no_dox")
    )
    
    res <- as.data.frame(res)
    
    res$GeneID <- rownames(res)
    
    res
}
main_dox_vs_main <- run_dox_comparison("main")

near_dox_vs_near <- run_dox_comparison("near")

far_dox_vs_far <- run_dox_comparison("far")

luc_dox_vs_luc <- run_dox_comparison("luc")

library(dplyr)


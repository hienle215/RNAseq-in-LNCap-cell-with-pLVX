library(rtracklayer)
library(dplyr)

gtf <- import("gencode.v48.annotation.gtf.gz")
head(as.data.frame(gtf))
gtf_df <- as.data.frame(gtf)

protein_coding <- gtf_df %>%
    filter(
        type == "gene",

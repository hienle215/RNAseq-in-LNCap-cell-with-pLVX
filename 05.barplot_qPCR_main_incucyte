# ============================================================
# Barplot: luc and main
# Dox- vs Dox+
# Mean ± SD + individual replicates + p-values (label only, no bracket)
# ============================================================

library(ggplot2)
library(dplyr)

# ------------------------------------------------------------
# 1. Input data
# ------------------------------------------------------------

df <- data.frame(
  Reporter = rep(c("luc", "main"), each = 6),
  Condition = rep(c("Dox-", "Dox+"), each = 3, times = 2),
  Replicate = rep(1:3, times = 4),
  Normalized_value = c(
    1.06, 0.87, 1.09,       # luc
    0.37, 1.74, 1.57,       # luc + Dox
    8.92, 9.24, 7.90,       # main
    185.83, 74.24, 152.21   # main + Dox
  )
)

df$Reporter <- factor(
  df$Reporter,
  levels = c("luc", "main")
)

df$Condition <- factor(
  df$Condition,
  levels = c("Dox-", "Dox+")
)

# ------------------------------------------------------------
# 2. Calculate p-values
#    Dox- vs Dox+ within each reporter
# ------------------------------------------------------------

p_luc <- t.test(
  Normalized_value ~ Condition,
  data = df %>% filter(Reporter == "luc"),
  var.equal = FALSE
)$p.value

p_main <- t.test(
  Normalized_value ~ Condition,
  data = df %>% filter(Reporter == "main"),
  var.equal = FALSE
)$p.value

cat("luc: Dox- vs Dox+ p =", p_luc, "\n")
cat("main: Dox- vs Dox+ p =", p_main, "\n")

# ------------------------------------------------------------
# 3. Create p-value labels
# ------------------------------------------------------------

p_label_luc <- paste0(
  "p = ",
  format.pval(p_luc, digits = 3, eps = 0.001)
)

p_label_main <- paste0(
  "p = ",
  format.pval(p_main, digits = 3, eps = 0.001)
)

# ------------------------------------------------------------
# 4. Calculate means and SD
# ------------------------------------------------------------

summary_df <- df %>%
  group_by(Reporter, Condition) %>%
  summarise(
    mean = mean(Normalized_value),
    sd = sd(Normalized_value),
    .groups = "drop"
  )

# ------------------------------------------------------------
# 5. Plot
# ------------------------------------------------------------

p <- ggplot(
  df,
  aes(
    x = Reporter,
    y = Normalized_value,
    fill = Condition
  )
) +

  # Mean bars
  stat_summary(
    fun = mean,
    geom = "bar",
    position = position_dodge(width = 0.75),
    width = 0.6,
    color = "black"
  ) +

  # Mean ± SD
  stat_summary(
    fun.data = mean_sdl,
    fun.args = list(mult = 1),
    geom = "errorbar",
    position = position_dodge(width = 0.75),
    width = 0.15,
    color = "black"
  ) +

  # Individual replicates
  geom_point(
    position = position_jitterdodge(
      jitter.width = 0.08,
      dodge.width = 0.75
    ),
    size = 2.5,
    color = "black"
  ) +

  # Colors
  scale_fill_manual(
    values = c(
      "Dox-" = "#F8766D",
      "Dox+" = "#00BFC4"
    )
  ) +

  labs(
    x = NULL,
    y = "Normalized value",
    fill = "Condition"
  ) +

  # Y axis
  scale_y_continuous(
    limits = c(0, 220),
    expand = expansion(mult = c(0, 0.03))
  ) +

  theme_classic(base_size = 14) +

  theme(
    legend.position = "right",
    axis.text.x = element_text(size = 13),
    axis.text.y = element_text(size = 12)
  )

# ------------------------------------------------------------
# 6. P-value label for luc (no bracket lines)
# ------------------------------------------------------------

p <- p +
  annotate(
    "text",
    x = 1,
    y = 6,
    label = p_label_luc,
    size = 4
  )

# ------------------------------------------------------------
# 7. P-value label for main (no bracket lines)
# ------------------------------------------------------------

p <- p +
  annotate(
    "text",
    x = 2,
    y = 218,
    label = p_label_main,
    size = 4
  )

# ------------------------------------------------------------
# 8. Display
# ------------------------------------------------------------

print(p)
library(ggpubr)
ggexport(p, filename = "qPCR_main.tiff", width = 1000,   height = 1200,  res = 300)

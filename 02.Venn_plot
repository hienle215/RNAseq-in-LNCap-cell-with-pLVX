################## VENN PLOT ####################################################################################################################

main <- run_DESeq_group("main")
far  <- run_DESeq_group("far")
near <- run_DESeq_group("near")
luc  <- run_DESeq_group("luc")
main.up <- read.csv("main_results/main_UP.csv")
far.up  <- read.csv("far_results/far_UP.csv")
near.up <- read.csv("near_results/near_UP.csv")
luc.up  <- read.csv("luc_results/luc_UP.csv")

main.down <- read.csv("main_results/main_DOWN.csv")
far.down  <- read.csv("far_results/far_DOWN.csv")
near.down <- read.csv("near_results/near_DOWN.csv")
luc.down  <- read.csv("luc_results/luc_DOWN.csv")

library(VennDiagram)

venn.diagram(  x = list(
        Main = main.up$SYMBOL,
        Far  = far.up$SYMBOL,
        Near = near.up$SYMBOL,
        Luc  = luc.up$SYMBOL ),    filename = "UP_genes_venn.png")

venn.diagram(
    x = list(
        Main = main.down$SYMBOL,
        Far  = far.down$SYMBOL,
        Near = near.down$SYMBOL,
        Luc  = luc.down$SYMBOL ),    filename = "DOWN_genes_venn.png")


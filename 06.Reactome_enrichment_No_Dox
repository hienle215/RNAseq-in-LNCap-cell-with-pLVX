####################################################################################
# 05. Reactome enrichment
########################################################################################
library(ReactomePA)
library(clusterProfiler)
library(org.Hs.eg.db)
library(dplyr)
convert_ensembl_to_entrez <- function(genes) {
  
  converted <- bitr(
    genes,
    fromType = "ENSEMBL",
    toType = "ENTREZID",
    OrgDb = org.Hs.eg.db
  )
  
  converted %>%
    filter(!is.na(ENTREZID)) %>%
    pull(ENTREZID) %>%
    unique()
}


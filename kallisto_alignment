#!/bin/bash -l
#SBATCH -J kallisto_quant
#SBATCH --partition=small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=15:00:00
#SBATCH --array=1-24
#SBATCH --constraint=skylake
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=hien.le@tuni.fi

set -euo pipefail

#############################
# Paths
#############################

RAW_DIR="/scratch/svc_td_mbpcg/projects/HanaL/RNAseq/Novogene/extracted/X208SC26072014-Z01-F001_02/01.RawData"

OUT_DIR="/scratch/svc_td_mbpcg/projects/HanaL/RNAseq/Novogene/extracted/X208SC26072014-Z01-F001_02/output_kallisto"

KALLISTO_INDEX="/scratch/svc_td_mbpcg/projects/HanaL/input/reference_hg38/gencode_v48_filtered.idx"

mkdir -p "${OUT_DIR}"

#############################
# Load module
#############################

module purge
module load bio/kallisto/0.51.1-gompi-2023b

#############################
# Sample list
#############################

mapfile -t SAMPLE_DIRS < <(
    find "${RAW_DIR}" -mindepth 1 -maxdepth 1 -type d | sort
)

NUM_SAMPLES=${#SAMPLE_DIRS[@]}

if (( SLURM_ARRAY_TASK_ID > NUM_SAMPLES )); then
    echo "Task exceeds number of samples."
    exit 0
fi

SAMPLE_DIR="${SAMPLE_DIRS[$((SLURM_ARRAY_TASK_ID-1))]}"
SAMPLE_NAME=$(basename "${SAMPLE_DIR}")

echo "Processing ${SAMPLE_NAME}"

#############################
# Find FASTQs
#############################

mapfile -t R1_FILES < <(
    find "${SAMPLE_DIR}" -maxdepth 1 -type f -name "*_1.fq.gz" | sort
)

mapfile -t R2_FILES < <(
    find "${SAMPLE_DIR}" -maxdepth 1 -type f -name "*_2.fq.gz" | sort
)

echo "R1 files:"
printf '%s\n' "${R1_FILES[@]}"

echo "R2 files:"
printf '%s\n' "${R2_FILES[@]}"

if [[ ${#R1_FILES[@]} -eq 0 || ${#R2_FILES[@]} -eq 0 ]]; then
    echo "FASTQ files missing!"
    exit 1
fi

if [[ ${#R1_FILES[@]} -ne ${#R2_FILES[@]} ]]; then
    echo "Unequal numbers of R1 and R2 files!"
    exit 1
fi

#############################
# Output
#############################

SAMPLE_OUT="${OUT_DIR}/${SAMPLE_NAME}"

if [[ -f "${SAMPLE_OUT}/abundance.tsv" ]]; then
    echo "${SAMPLE_NAME} already completed."
    exit 0
fi

#############################
# Run kallisto
#############################

kallisto quant \
    -i "${KALLISTO_INDEX}" \
    -o "${SAMPLE_OUT}" \
    -t ${SLURM_CPUS_PER_TASK} \
    -b 100 \
    "${R1_FILES[@]}" \
    "${R2_FILES[@]}"

echo "Finished ${SAMPLE_NAME}"

# make a function to create the GSEA ranked list
make_gene_rank <- function(res_df) {
        rank_df <- res_df %>%
        filter(
            !is.na(SYMBOL),
            SYMBOL != "",
            !is.na(stat)
        ) %>%
        group_by(SYMBOL) %>%
        slice_max(
            order_by = abs(stat),
            n = 1,
            with_ties = FALSE
        ) %>%
        ungroup()
    
    gene_rank <- rank_df$stat
    names(gene_rank) <- rank_df$SYMBOL
    
    gene_rank <- sort(
        gene_rank,
        decreasing = TRUE
    )
    
    return(gene_rank)
}
rank_main <- make_gene_rank(res.main.df)
rank_near <- make_gene_rank(res.near.df)
rank_far <- make_gene_rank(res.far.df)

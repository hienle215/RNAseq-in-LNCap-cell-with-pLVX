### heatmap for gsea information with the list of gsea from gsea_main with padj less 0.05
library(data.table)
library(dplyr)
library(pheatmap)

# 1. Select pathways significant in Main
main.sig.pathways <- gsea_main %>%
  filter(padj < 0.05) %>%
  pull(pathway)

# 2. Function to convert GSEA result to categorical status
get_gsea_status <- function(df, pathways) {
  
  df %>%
    filter(pathway %in% pathways) %>%
    select(pathway, NES, padj) %>%
    mutate(
      status = case_when(
        padj < 0.05 & NES > 0 ~ 1,    # UP
        padj < 0.05 & NES < 0 ~ -1,   # DOWN
        TRUE ~ 0                      # N/A
      )
    ) %>%
    select(pathway, status)
}

# 3. Get status for each comparison
main.status <- get_gsea_status(gsea_main, main.sig.pathways) %>%
  rename(Main = status)

del4.status <- get_gsea_status(gsea_del4, main.sig.pathways) %>%
  rename(Del4 = status)

del56.status <- get_gsea_status(gsea_del56, main.sig.pathways) %>%
  rename(Del56 = status)

# 4. Combine
gsea.heatmap <- main.status %>%
  full_join(del4.status, by = "pathway") %>%
  full_join(del56.status, by = "pathway")

# 5. Replace missing pathways with N/A = 0
gsea.heatmap[is.na(gsea.heatmap)] <- 0

# 6. Make pathway names the row names
gsea.matrix <- gsea.heatmap %>%
  as.data.frame()

rownames(gsea.matrix) <- gsea.matrix$pathway
gsea.matrix$pathway <- NULL

gsea.matrix <- as.matrix(gsea.matrix)

# 7. Heatmap
gsea = pheatmap(
  gsea.matrix,
  cluster_rows = TRUE,
  cluster_cols = FALSE,
  color = c(
    "lightblue",  # DOWN
    "grey90",     # N/A
    "lightcoral"  # UP
  ),
  breaks = c(-1.5, -0.5, 0.5, 1.5),
  border_color = "white",
  fontsize_row = 9,
  fontsize_col = 11,
  main = "GSEA pathways significant in Main"
)
ggexport(gsea ,filename = "gsea _main_del4_del56_10_2026.tiff", width = 1500,   height = 1800,  res = 300)


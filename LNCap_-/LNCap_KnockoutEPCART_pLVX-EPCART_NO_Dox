### calculate z-score
library(msigdbr)

hallmark <- msigdbr(
    species = "Homo sapiens",
    collection = "H"
)

hallmark_list <- split(
    hallmark$gene_symbol,
    hallmark$gs_name
)
calculate_hallmark_score <- function(res_df, hallmark_list) {
    
    df <- res_df %>%
        filter(
            !is.na(SYMBOL),
            SYMBOL != "",
            !is.na(stat)
        ) %>%
        group_by(SYMBOL) %>%
        slice_max(
            abs(stat),
            n = 1,
            with_ties = FALSE
        ) %>%
        ungroup()
    
    scores <- sapply(
        hallmark_list,
        function(genes) {
            
            x <- df$stat[df$SYMBOL %in% genes]
            
            if (length(x) < 5) {
                return(NA_real_)
            }
            
            mean(x, na.rm = TRUE)
        }
    )
    
    scores
}
score_main <- calculate_hallmark_score(
    res.main.df,
    hallmark_list
)

score_near <- calculate_hallmark_score(
    res.near.df,
    hallmark_list
)

score_far <- calculate_hallmark_score(
    res.far.df,
    hallmark_list
)

score_del4 <- calculate_hallmark_score(
    res_del4,
    hallmark_list
)

score_del56 <- calculate_hallmark_score(
    res_del56,
    hallmark_list
)

score_matrix <- cbind(
    main = score_main,
    near = score_near,
    far = score_far,
    del4 = score_del4,
    del56 = score_del56
)
z_matrix <- t(
    apply(
        score_matrix,
        1,
        function(x) {
            
            if (all(is.na(x))) {
                return(rep(NA, length(x)))
            }
            
            s <- sd(x, na.rm = TRUE)
            
            if (is.na(s) || s == 0) {
                return(rep(0, length(x)))
            }
            
            (x - mean(x, na.rm = TRUE)) / s
        }
    )
)
rownames(z_matrix) <- rownames(score_matrix)
colnames(z_matrix) <- colnames(score_matrix)

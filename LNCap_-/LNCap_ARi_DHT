# 5 make volcano plots
make_volcano <- function(res_df, title, filename) {

  df <- res_df %>%
    mutate(
      status = case_when(
        !is.na(padj) & padj < 0.05 & log2FoldChange > 1 ~ "Up",
        !is.na(padj) & padj < 0.05 & log2FoldChange < -1 ~ "Down",
        TRUE ~ "Not significant"
      ),
      neglog10padj = -log10(pmax(padj, 1e-300))
    )

  labels <- df %>%
    filter(status %in% c("Up", "Down")) %>%
    group_by(status) %>%
    arrange(padj, .by_group = TRUE) %>%
    slice_head(n = 10) %>%
    ungroup() %>%
    mutate(label = ifelse(
      is.na(gene_symbol) | gene_symbol == "",
      gene_id, gene_symbol
    ))

  p <- ggplot(df, aes(log2FoldChange, neglog10padj)) +
    geom_point(aes(color = status), alpha = 0.7, size = 1.3) +
    geom_vline(xintercept = c(-1, 1), linetype = "dashed") +
    geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
    geom_text(
      data = labels,
      aes(label = label),
      check_overlap = TRUE,
      size = 3,
      vjust = -0.5
    ) +
    scale_color_manual(values = c(
      "Up" = "#D73027",
      "Down" = "#4575B4",
      "Not significant" = "grey75"
    )) +
    labs(
      title = title,
      x = "Log2 fold change",
      y = "-Log10 adjusted p-value",
      color = NULL
    ) +
    theme_classic(base_size = 12)

  ggsave(
    file.path(out_dir, filename),
    p, width = 9, height = 7, dpi = 300
  )

  print(p)
}


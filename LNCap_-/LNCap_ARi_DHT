# Reactome gene sets
msig_r <- msigdbr(
  species = "Homo sapiens",
  collection = "C2",
  subcollection = "CP:REACTOME"
)

pathways_r <- split(msig_r$gene_symbol, msig_r$gs_name)

run_gsea <- function(res_df, pathways, prefix) {

  ranked <- res_df %>%
    filter(
      !is.na(stat),
      !is.na(gene_symbol),
      gene_symbol != "",
      gene_symbol != "-"
    ) %>%
    group_by(gene_symbol) %>%
    slice_max(
      order_by = abs(stat),
      n = 1,
      with_ties = FALSE
    ) %>%
    ungroup()

  stats <- ranked$stat
  names(stats) <- ranked$gene_symbol
  stats <- sort(stats, decreasing = TRUE)

  set.seed(123)

  fg <- fgsea(
    pathways = pathways,
    stats = stats,
    minSize = 10,
    maxSize = 500,
    eps = 0
  ) %>%
    as.data.frame() %>%
    arrange(padj)

  # Make the leading-edge column easier to save to CSV
  fg$leadingEdge <- vapply(
    fg$leadingEdge,
    paste,
    collapse = ";",
    FUN.VALUE = character(1)
  )

  write.csv(
    fg,
    file.path(out_dir, paste0(prefix, ".csv")),
    row.names = FALSE
  )

  fg
}


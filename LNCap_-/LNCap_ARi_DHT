run_deseq <- function(count_mat, metadata,
                      reference_group, comparison_group,
                      prefix) {

  keep <- metadata$group %in% c(reference_group, comparison_group)

  meta <- metadata[keep, , drop = FALSE]
  meta$group <- factor(
    meta$group,
    levels = c(reference_group, comparison_group)
  )
  rownames(meta) <- meta$sample

  mat <- count_mat[, meta$sample, drop = FALSE]

  dds <- DESeqDataSetFromMatrix(
    countData = mat,
    colData = meta,
    design = ~ group
  )

  # Remove genes with very low counts
  dds <- dds[rowSums(counts(dds)) >= 10, ]

  dds <- DESeq(dds)

  res <- results(
    dds,
    contrast = c("group", comparison_group, reference_group),
    alpha = 0.05
  )

  res_df <- as.data.frame(res) %>%
    rownames_to_column("gene_id") %>%
    arrange(padj)

  write.csv(
    res_df,
    file.path(out_dir, paste0(prefix, "_DESeq2.csv")),
    row.names = FALSE
  )

  # Variance-stabilized expression for PCA and heatmaps
  vsd <- vst(dds, blind = FALSE)

  write.csv(
    as.data.frame(counts(dds, normalized = TRUE)) %>%
      rownames_to_column("gene_id"),
    file.path(out_dir, paste0(prefix, "_normalized_counts.csv")),
    row.names = FALSE
  )

  list(
    dds = dds,
    res = res_df,
    vst = assay(vsd),
    metadata = meta
  )
}


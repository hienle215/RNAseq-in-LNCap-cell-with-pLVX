######################################### 03.heatmap of shared gene############################################################
############# creat up and down regulation ##################################
# UP-regulated genes
main.up <- main.sig %>%
    filter(log2FoldChange >= 1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()

near.up <- near.sig %>%
    filter(log2FoldChange >= 1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()

far.up <- far.sig %>%
    filter(log2FoldChange >= 1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()


# DOWN-regulated genes
main.down <- main.sig %>%
    filter(log2FoldChange <= -1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()

near.down <- near.sig %>%
    filter(log2FoldChange <= -1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()

far.down <- far.sig %>%
    filter(log2FoldChange <= -1) %>%
    filter(!is.na(SYMBOL)) %>%
    pull(SYMBOL) %>%
    unique()
######################### finding the shared genes###################################
shared.up <- Reduce(
    intersect,
    list(main.up, near.up, far.up)
)

shared.down <- Reduce(
    intersect,
    list(main.down, near.down, far.down)
)
shared.up
shared.down

length(shared.up)
length(shared.down)

############### Make the log fold change for heatmap##################################
shared.genes <- c(shared.up, shared.down)
main.fc <- main.sig %>%
    filter(SYMBOL %in% shared.genes) %>%
    select(SYMBOL, log2FoldChange) %>%
    distinct(SYMBOL, .keep_all = TRUE)

near.fc <- near.sig %>%
    filter(SYMBOL %in% shared.genes) %>%
    select(SYMBOL, log2FoldChange) %>%
    distinct(SYMBOL, .keep_all = TRUE)

far.fc <- far.sig %>%
    filter(SYMBOL %in% shared.genes) %>%
    select(SYMBOL, log2FoldChange) %>%
    distinct(SYMBOL, .keep_all = TRUE)
fc.data <- main.fc %>%
    rename(Main = log2FoldChange) %>%
    full_join(
        near.fc %>% rename(Near = log2FoldChange),
        by = "SYMBOL"
    ) %>%
    full_join(
        far.fc %>% rename(Far = log2FoldChange),
        by = "SYMBOL"
    ) # combine the data
head(fc.data)

library(pheatmap)
fc.mat <- as.matrix(fc.data[, c("Main", "Near", "Far")])
rownames(fc.mat) <- fc.data$SYMBOL
# UP genes first, DOWN genes second
ordered.genes <- c(shared.up, shared.down)
fc.mat <- fc.mat[ordered.genes, ]
heatmap = pheatmap(
    fc.mat,
    scale = "none",
    cluster_rows = TRUE,
    cluster_cols = FALSE,
    border_color = NA,
    fontsize_row = 8,
    fontsize_col = 12,
    main = "Shared differentially expressed genes",
    
    # Strong blue → white → strong red
    color = colorRampPalette(
        c("royalblue3", "white", "red3")
    )(100),
    
    # Symmetric scale around zero
    breaks = seq(-4, 4, length.out = 101)
)
library(ggpubr)
setwd("C:/Users/leh/OneDrive - TUNI.fi/Desktop/lncRNA_prostate_cancer/RNAseq_Novogene_2026")
ggexport(heatmap, filename = "heatmap_shared_gene_Doxycycline.tiff", width = 3000,   height = 1800,  res = 300)

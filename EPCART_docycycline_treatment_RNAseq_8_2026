make_rank <- function(df) {
    
    x <- df %>%
        filter(
            !is.na(SYMBOL),
            SYMBOL != "",
            !is.na(stat)
        ) %>%
        group_by(SYMBOL) %>%
        slice_max(
            order_by = abs(stat),
            n = 1
        ) %>%
        ungroup()
    
    rank <- x$stat
    names(rank) <- x$SYMBOL
    
    rank <- sort(rank, decreasing = TRUE)
    
    return(rank)
}
